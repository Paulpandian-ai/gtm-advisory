# ── AWS Region ──────────────────────────────────────────
# Amplify doesn't allow env vars starting with "AWS_".
# Use APP_REGION for Amplify, AWS_REGION for local dev.
APP_REGION=us-east-1

# ── DynamoDB Tables ─────────────────────────────────────
# These use on-demand (PAY_PER_REQUEST) billing mode.
# Create them with: ./scripts/deploy.sh
DYNAMODB_COMPANIES_TABLE=horizon-companies
DYNAMODB_BENCHMARKS_TABLE=horizon-benchmarks
DYNAMODB_SOURCES_TABLE=horizon-sources
DYNAMODB_INSIGHTS_TABLE=horizon-insights

# ── DynamoDB Local (optional) ───────────────────────────
# Set this to use DynamoDB Local for development.
# DYNAMODB_ENDPOINT=http://localhost:8000

# ── S3 ──────────────────────────────────────────────────
S3_DATA_BUCKET=horizon-data

# ── Bedrock ─────────────────────────────────────────────
# No config needed — uses IAM role credentials.
# Models used: us.anthropic.claude-sonnet-4-20250514-v1:0
# Ensure Bedrock model access is enabled in your AWS account.
# Submit use case details form if prompted.

# ── NextAuth (optional, for future auth) ────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate-a-random-secret-here
